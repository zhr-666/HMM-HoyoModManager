{
  "name": "hoyo-mod-library",
  "version": "0.6.1",
  "description": "原神 Mod 集中管理器",
  "author": "HoYo Mod Library contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:win": "electron-builder --win zip --x64",
    "pack:mac": "electron-builder --mac dir"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.hoyomod.library",
    "productName": "HoYoMod",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "README.md",
        "to": "使用说明.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-HoYoMod.txt"
      },
      {
        "from": "docs/acceptance.md",
        "to": "Windows验收说明.md"
      }
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**/*",
      "node_modules/node-unrar-js/**/*.wasm"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "HoYoMod-${version}-Windows-${arch}.${ext}",
    "mac": {
      "identity": null
    }
  }
}
